#!/usr/bin/env bash
# morph-stream: Run any terminal command while live-streaming status & output directly into Morph's Dynamic Notch!
# Usage:
#   morph-stream "npm run build"
#   morph-stream --title "Compiling Rust" cargo build --release
#   morph-stream swift test

set -euo pipefail

TITLE=""
if [[ $# -ge 2 && "$1" == "--title" ]]; then
    TITLE="$2"
    shift 2
fi

if [[ $# -eq 0 ]]; then
    echo "Usage: morph-stream [--title <name>] <command...>"
    exit 1
fi

CMD_STRING="$*"
if [[ -z "$TITLE" ]]; then
    TITLE="$1"
fi

TASK_ID="task-$(date +%s)-$RANDOM"

# Tell Morph a task started
osascript -l JavaScript -e "
    var notif = $.NSDistributedNotificationCenter.defaultCenter;
    var dict = $.NSMutableDictionary.alloc.init;
    dict.setObjectForKey(\"$TITLE\", \"title\");
    dict.setObjectForKey(\"$CMD_STRING\", \"command\");
    dict.setObjectForKey(\"$TASK_ID\", \"id\");
    notif.postNotificationNameObjectUserInfoDeliverImmediately(\"com.morph.devTask.start\", null, dict, true);
" 2>/dev/null || true

# Execute command while streaming stdout line-by-line into terminal and Morph
STATUS_CODE=0
"$@" 2>&1 | while IFS= read -r line; do
    echo "$line"
    # Post line to Morph notch
    ESCAPED_LINE=$(printf '%s' "$line" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r//g')
    osascript -l JavaScript -e "
        var notif = $.NSDistributedNotificationCenter.defaultCenter;
        var dict = $.NSMutableDictionary.alloc.init;
        dict.setObjectForKey(\"$ESCAPED_LINE\", \"line\");
        notif.postNotificationNameObjectUserInfoDeliverImmediately(\"com.morph.devTask.output\", null, dict, true);
    " 2>/dev/null || true
done || STATUS_CODE=$?

IS_SUCCESS=true
if [[ $STATUS_CODE -ne 0 ]]; then
    IS_SUCCESS=false
fi

# Tell Morph the task completed
osascript -l JavaScript -e "
    var notif = $.NSDistributedNotificationCenter.defaultCenter;
    var dict = $.NSMutableDictionary.alloc.init;
    dict.setObjectForKey($.NSNumber.numberWithBool($IS_SUCCESS), \"isSuccess\");
    dict.setObjectForKey($.NSNumber.numberWithInt($STATUS_CODE), \"exitCode\");
    dict.setObjectForKey(\"$TASK_ID\", \"id\");
    notif.postNotificationNameObjectUserInfoDeliverImmediately(\"com.morph.devTask.complete\", null, dict, true);
" 2>/dev/null || true

exit $STATUS_CODE
