#!/usr/bin/env bash
# morph-approve: Block until approval is granted via Morph Notch!
# Usage:
#   morph-approve "git push origin main --force"
#   morph-approve --risk high "terraform destroy"

set -euo pipefail

RISK="medium"
TIMEOUT=30
SOURCE="Terminal"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --risk)
            RISK="$2"
            shift 2
            ;;
        --timeout)
            TIMEOUT="$2"
            shift 2
            ;;
        --source)
            SOURCE="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "Usage: morph-approve [--risk low|medium|high] [--timeout <secs>] <command...>"
    exit 1
fi

CMD_STRING="$*"
REQ_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')

echo "🛡️  Morph Approval Gate: Requesting authorization for: '$CMD_STRING'"
echo "👉 Check your MacBook notch to Allow or Deny..."

# Request approval in Morph
osascript -l JavaScript -e "
    var notif = $.NSDistributedNotificationCenter.defaultCenter;
    var dict = $.NSMutableDictionary.alloc.init;
    dict.setObjectForKey(\"$CMD_STRING\", \"command\");
    dict.setObjectForKey(\"$REQ_ID\", \"id\");
    dict.setObjectForKey(\"$RISK\", \"riskLevel\");
    dict.setObjectForKey($.NSNumber.numberWithDouble($TIMEOUT), \"timeout\");
    dict.setObjectForKey(\"$SOURCE\", \"source\");
    notif.postNotificationNameObjectUserInfoDeliverImmediately(\"com.morph.requestApproval\", null, dict, true);
" 2>/dev/null || true

# Wait for decision using a temporary observer script or poll state
# In macOS bash, we can run a lightweight python/jxa listener or swift one-liner:
DECISION=$(osascript -l JavaScript -e "
    var done = false;
    var result = 'expired';
    var notifCenter = $.NSDistributedNotificationCenter.defaultCenter;
    
    var Observer = ObjC.registerSubclass({
        name: 'MorphApprovalObserver_' + '$REQ_ID'.replace(/-/g, '_'),
        methods: {
            'handleDecision:': {
                types: ['void', ['id']],
                implementation: function(notif) {
                    var info = notif.userInfo;
                    if (info) {
                        result = ObjC.unwrap(info.objectForKey('decision')) || 'approved';
                    }
                    done = true;
                }
            }
        }
    });
    
    var obs = Observer.alloc.init;
    notifCenter.addObserverSelectorNameObject(obs, 'handleDecision:', 'com.morph.commandApprovalDecision.' + '$REQ_ID', null);
    
    var start = Date.now();
    var timeoutMs = $TIMEOUT * 1000;
    while (!done && (Date.now() - start) < timeoutMs) {
        $.NSRunLoop.currentRunLoop.runModeBeforeDate($.NSDefaultRunLoopMode, $.NSDate.dateWithTimeIntervalSinceNow(0.1));
    }
    
    notifCenter.removeObserver(obs);
    result;
" 2>/dev/null || echo "approved")

if [[ "$DECISION" == "approved" ]]; then
    echo "✅ Approved via Morph Notch! Executing..."
    eval "$CMD_STRING"
elif [[ "$DECISION" == "rejected" ]]; then
    echo "❌ Command rejected via Morph Notch."
    exit 1
else
    echo "⏱️ Command approval timed out."
    exit 124
fi
